# ============================================================
#  AI AGENT BOOTSTRAP - environment example
#  Copy to .env and fill in. NEVER commit .env
# ============================================================

# ---------- Telegram (WAJIB) ----------
TELEGRAM_BOT_TOKEN=
# Comma separated numeric user ids allowed to use the bot (fail-closed if empty)
TELEGRAM_ALLOWED_USER_IDS=
# Admin ids can run /admin commands (reload config, view budget)
TELEGRAM_ADMIN_USER_IDS=
# Optional: use a local Bot API server instead of api.telegram.org.
# Must include the /bot suffix, e.g. http://localhost:8081/bot
TELEGRAM_API_BASE=

# ---------- LLM providers (isi minimal 1, sisanya opsional untuk fallback) ----------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional self-hosted / custom OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ---------- Web search (belajar) ----------
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# ---------- Memory / vector store ----------
CHROMA_HOST=
CHROMA_PORT=8000
MEMORY_DIR=./data/memory
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Image / video / audio providers ----------
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
REPLICATE_API_TOKEN=
MANIM_QUALITY=medium_quality

# ---------- Deployment (web) ----------
GITHUB_TOKEN=
GITHUB_OWNER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RENDER_API_KEY=
RENDER_OWNER_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ---------- n8n ----------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ---------- YouTube (link ingestion fallback) ----------
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=./data/youtube_token.json
YTDLP_COOKIES_FILE=

# ---------- Runtime tuning ----------
LLM_FALLBACK_ORDER=groq,gemini,openrouter,hf,openai
SMALL_MODEL=groq/llama-3.1-8b-instant
BIG_MODEL=groq/llama-3.3-70b-versatile
DAILY_TOKEN_BUDGET=200000
SEMANTIC_CACHE_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true
TZ=Asia/Jakarta

# ---------- Runtime / limits ----------
OUTPUTS_DIR=./outputs
DATA_DIR=./data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEMORY_TOP_K=6
MEMORY_MAX_CONTEXT_TOKENS=1200
MAX_UPLOAD_MB=45
RATE_LIMIT_PER_MINUTE=20
HEAVY_TASK_DAILY_LIMIT=25

# ---------- n8n (self-host) ----------
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change-me
